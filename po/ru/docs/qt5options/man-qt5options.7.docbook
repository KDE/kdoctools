<refnamediv>
<refname
>qt5options</refname>
<refpurpose
>Общие параметры командной строки для всех приложений на основе библиотеки &Qt;</refpurpose>
</refnamediv>

<refsynopsisdiv>
<cmdsynopsis
><command
><replaceable
>приложение Qt</replaceable
></command
> <arg choice="opt"
><option
>-style=</option
> <replaceable
>стиль</replaceable
> / <option
>-style</option
> <replaceable
>стиль</replaceable
></arg
> <arg choice="opt"
><option
>-stylesheet=</option
> <replaceable
>таблица-стилей</replaceable
> / <option
>-stylesheet</option
> <replaceable
>таблица-стилей</replaceable
></arg
> <arg choice="opt"
><option
>-widgetcount</option
></arg
> <arg choice="opt"
><option
>-reverse</option
></arg
> <arg choice="opt"
><option
>-qmljsdebugger=</option
> <replaceable
>порт</replaceable
></arg
> <arg choice="opt"
><option
>-platform</option
> <replaceable
>имя-платформы[:параметры]</replaceable
></arg
> <arg choice="opt"
><option
>-platformpluginpath</option
> <replaceable
>путь</replaceable
></arg
> <arg choice="opt"
><option
>-platformtheme</option
> <replaceable
>тема-платформы</replaceable
></arg
> <arg choice="opt"
><option
>-plugin</option
> <replaceable
>модуль</replaceable
></arg
> <arg choice="opt"
><option
>-qwindowgeometry</option
> <replaceable
>геометрия</replaceable
></arg
> <arg choice="opt"
><option
>-qwindowicon</option
> <replaceable
>значок</replaceable
></arg
> <arg choice="opt"
><option
>-qwindowtitle</option
> <replaceable
>заголовок</replaceable
></arg
> <arg choice="opt"
><option
>-reverse</option
></arg
